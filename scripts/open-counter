#!/usr/bin/env bash
# Open the counter again. The shop is already running in its own window.

set -euo pipefail
source "$(dirname "$0")/common.sh"
ROOT="$(shop_root "$0")"
PORT="$(shop_port "$ROOT")"
URL="http://127.0.0.1:${PORT}/admin/"

if shop_healthy "$PORT"; then
  open_window "$URL"
  exit 0
fi
open_window "$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$ROOT/src/printo/web/offline.html")"
exit 1
