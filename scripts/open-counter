#!/usr/bin/env bash
# Open the counter. printO is already running; this only opens a window onto it.

set -euo pipefail
source "$(dirname "$0")/common.sh"
ROOT="$(shop_root "$0")"
PORT="$(shop_port "$ROOT")"
URL="http://127.0.0.1:${PORT}/admin/"

healthy() {
  python3 - "$PORT" << 'PY'
import sys, urllib.request
port = sys.argv[1]
try:
    urllib.request.urlopen(f"http://127.0.0.1:{port}/admin/health", timeout=2).read()
except Exception:
    sys.exit(1)
PY
}

open_target() {
  local target="$1"
  if command -v google-chrome >/dev/null; then nohup google-chrome --app="$target" >/dev/null 2>&1 &
  elif command -v chromium >/dev/null; then nohup chromium --app="$target" >/dev/null 2>&1 &
  elif command -v chromium-browser >/dev/null; then nohup chromium-browser --app="$target" >/dev/null 2>&1 &
  elif command -v firefox >/dev/null; then nohup firefox --new-window "$target" >/dev/null 2>&1 &
  else nohup xdg-open "$target" >/dev/null 2>&1 &
  fi
}

if healthy; then
  open_target "$URL"
  exit 0
fi
open_target "$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$ROOT/src/printo/web/offline.html")"
exit 1
